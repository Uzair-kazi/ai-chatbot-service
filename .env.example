# Database Configuration
DB_URL="postgresql://chatbot_readonly:123456@localhost:5432/tank_depot"

# JWT Authentication (must match Node.js backend)
JWT_SECRET_KEY="your_jwt_secret_key_here"

# AI Provider Configuration
# AI_PROVIDER="deepseek"
# AI_API_KEY="your_api_key_here"
# AI_BASE_URL="https://api.deepseek.com"
# AI_MODEL="deepseek-chat"
# SDK_TYPE="openai_compatible"

# Alternative AI Provider Examples:
# 
# OpenAI:
AI_PROVIDER="openai"
AI_API_KEY="your_openai_api_key_here"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
SDK_TYPE="openai_compatible"
#
# Anthropic Claude:
# AI_PROVIDER="anthropic"
# AI_API_KEY="sk-ant-..."
# AI_BASE_URL=""  # Not used for Anthropic
# AI_MODEL="claude-sonnet-4-20250514"
# SDK_TYPE="anthropic"
#
# Groq:
# AI_PROVIDER="groq"
# AI_API_KEY="gsk_..."
# AI_BASE_URL="https://api.groq.com/openai/v1"
# AI_MODEL="llama-3.3-70b-versatile"
# SDK_TYPE="openai_compatible"
#
# Ollama (local):
# AI_PROVIDER="ollama"
# AI_API_KEY="not_required"
# AI_BASE_URL="http://localhost:11434/v1"
# AI_MODEL="llama3"
# SDK_TYPE="openai_compatible"
#
# Gemini:
# AI_PROVIDER="gemini"
# AI_API_KEY="your_gemini_api_key_here"
# AI_BASE_URL=""  # Not needed for Gemini
# AI_MODEL="gemini-1.5-flash"
# SDK_TYPE="openai_compatible"  # Gemini supports OpenAI format


# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development  # or "production"

# CORS Configuration
# WARNING: CORS_ORIGINS="*" is NOT safe for production!
# Set to specific allowed origins before deploying:
# CORS_ORIGINS="https://admin.tankdepot.com,https://staging.tankdepot.com"
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Service Metadata
SERVICE_VERSION=1.0.0

# MCP (Model Context Protocol) Configuration
# MCP_SERVER_URL: URL of the MCP server for database operations
# MCP_DATABASE_NAME: Database name to use with MCP server
# MCP Server Configuration (optional - for Phase 4 MCP integration)
# See docs/MCP_SETUP.md for detailed setup instructions
# 
# Quick Start:
# 1. Install uv: curl -LsSf https://astral.sh/uv/install.sh | sh
# 2. Run MCP server: uvx mcp-server-postgres postgresql://postgres:postgres@localhost:5432/tank_depot
# 3. Uncomment and set MCP_SERVER_URL=http://localhost:3000
#
# If not configured, the system will use fallback mode (direct SQL execution)
# Leave empty to use fallback mode (direct database access)
# Example: MCP_SERVER_URL="http://localhost:3000"
# Example: MCP_DATABASE_NAME="tank_depot"
MCP_SERVER_URL=
MCP_DATABASE_NAME=

